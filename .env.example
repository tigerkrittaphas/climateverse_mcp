# Copy to .env for local development (never commit .env)
CLIMATEVERSE_API_KEY=your-api-key-here
CLIMATEVERSE_API_BASE_URL=https://india.climateverse.net

# Dataset discovery defaults to AIFindr. Set to dataverse for keyword search.
CLIMATEVERSE_SEARCH_PROVIDER=aifindr
AIFINDR_BASE_URL=https://your-aifindr-api.example.com
AIFINDR_API_KEY=key_your-private-api-key
AIFINDR_ORG_ID=org_your-organization-id
AIFINDR_PROJECT_ID=prj_your-project-id
AIFINDR_SEARCH_ALPHA=0.7
# Leave empty to follow the project's current knowledge collection.
AIFINDR_KNOWLEDGE_VERSION=
